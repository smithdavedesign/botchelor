  {
   "id": "pilot",
   "from": "2026-10-13",
   "to": "2026-10-19",
   "title": "The pilot",
   "blurb": "An idea at 7:44 on a Tuesday morning, a working first version by 2 pm. By Sunday: the date theater, a reunion special, texts, swipes and matches, couples who remember each other, and its own address, botchelor.com."
  },
  {
   "id": "map",
   "from": "2026-10-20",
   "to": "2026-10-26",
   "title": "The map",
   "blurb": "Characters got kinds and archetypes, and every date, crush and turn-down landed on one map: the Constellation. The show became an installable app, the swipe deck got faces, and people could bring their own AI key."
  },
  {
   "id": "moving-day",
   "from": "2026-10-27",
   "to": "2026-11-02",
   "title": "Moving day",
   "blurb": "The show moved to new hosting, its characters learned other languages, and a top-to-bottom review of every screen came back with a list. The fixes shipped within a day, each with proof."
  },
  {
   "id": "front-door",
   "from": "2026-11-03",
   "to": "2026-11-09",
   "title": "A new front door",
   "blurb": "A new home page, one art style for the whole season's cast and an anime one beside it, Sunday's reveal, and a way to bring your character over from another app."
  },
  {
   "id": "drama",
   "from": "2026-11-10",
   "to": "2026-11-16",
   "title": "The drama",
   "blurb": "Company pages and a design system, then the reality-TV layer: gossip in the house, confrontations and challenges, a producer planning tomorrow overnight, and the character's own phone with a photo from the date."
  },
  {
   "id": "glow-up",
   "from": "2026-11-17",
   "to": "2026-11-23",
   "title": "The glow-up",
   "blurb": "Writing styles, a cold open for dates, report cards, free tools for writers, every page checked on a phone, and a visual pass that put the show's stage behind its pages."
  }
